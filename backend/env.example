# .env.example

# Google AI Studio(https://aistudio.google.com/apikey)에서 발급받은 Gemini API 키
GEMINI_API_KEY=여기에_발급받은_키를_붙여넣으세요

# PostgreSQL 접속 정보
# Docker로 heritage-pg 컨테이너를 그대로 띄웠다면 아래 기본값을 그대로 써도 돼요.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=postgres

# 답변을 만드는 LLM 모델 (평가 결과 gemini-3.5-flash-lite로 확정)
# 모델은 이 파일(.env) 한 곳에서만 바꾸세요. 터미널에서 set 으로 지정한 값보다 .env가 항상 우선해요.
LLM_MODEL=gemini-3.5-flash-lite

# (선택) 기본 모델이 실패할 때 대신 쓸 예비 모델. 안 적으면 gemini-3.1-flash-lite를 써요.
# LLM_FALLBACK_MODEL=gemini-3.1-flash-lite

# (선택) 프론트엔드 주소 허용 목록(CORS). 쉼표로 구분. 안 적으면 Vite 개발 서버 주소를 써요.
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
